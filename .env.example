# Copie para .env para rodar local (netlify dev). Em produção, configure no painel do Netlify:
# Site configuration > Environment variables. NUNCA commite o .env.

# Obrigatórias
APP_PIN=troque-este-pin
GEMINI_API_KEY=

# Motores (trocar de motor = mudar estas variáveis, sem mexer no código)
TEXT_PROVIDER=gemini
ART_PROVIDER=local
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3-pro-image
# Modelos de reserva, usados em ordem se o principal falhar (separados por vírgula)
GEMINI_TEXT_FALLBACKS=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.1-flash-lite,gemini-3-flash-preview
GEMINI_IMAGE_FALLBACKS=gemini-nano-banana-2.1,gemini-3.1-flash-image,gemini-3.1-flash-lite-image

# Dados da corretora (aparecem nas legendas)
BROKER_NAME=SAMIA MOHAMED
BROKER_PHONE=(13) 98210-8455
BROKER_CRECI=76026

# Proteção de custo (por instância da função)
MAX_PIN_FAILS=8
MAX_GENERATIONS_PER_HOUR=30
